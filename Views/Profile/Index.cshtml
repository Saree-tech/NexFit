@model NexFit.Models.ApplicationUser

@{
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row">

        <!-- LEFT SIDE: Profile Form -->
        <div class="col-lg-8 mb-4">
            <div class="card shadow-lg border-0 rounded-4"
                 style="background: rgba(15,23,42,0.9); border: 1px solid rgba(255,255,255,0.06) !important;">
                <div class="card-body p-5">

                    <h2 class="fw-bold mb-4" style="color:white;">
                        My Fitness Profile
                    </h2>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["Success"]
                        </div>
                    }

                    <form asp-action="Update" method="post">
                        <div class="row">

                            <div class="col-md-6 mb-4">
                                <label class="form-label text-light">Full Name</label>
                                <input asp-for="FullName" class="form-control bg-dark text-white border-secondary" />
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label text-light">Age</label>
                                <input asp-for="Age" type="number" class="form-control bg-dark text-white border-secondary" />
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label text-light">Gender</label>
                                <select asp-for="Gender" class="form-select bg-dark text-white border-secondary">
                                    <option>Male</option>
                                    <option>Female</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label text-light">Height (CM)</label>
                                <input asp-for="Height" type="number" class="form-control bg-dark text-white border-secondary" />
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label text-light">Current Weight</label>
                                <input asp-for="Weight" type="number" class="form-control bg-dark text-white border-secondary" />
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label text-light">Goal Weight</label>
                                <input asp-for="GoalWeight" type="number" class="form-control bg-dark text-white border-secondary" />
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label text-light">Fitness Goal</label>
                                <input asp-for="FitnessGoal" class="form-control bg-dark text-white border-secondary" />
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label text-light">Activity Level</label>
                                <select asp-for="ActivityLevel" class="form-select bg-dark text-white border-secondary">
                                    <option>Beginner</option>
                                    <option>Intermediate</option>
                                    <option>Advanced</option>
                                </select>
                            </div>

                            <div class="col-12 mb-4">
                                <label class="form-label text-light">Bio</label>
                                <textarea asp-for="Bio" class="form-control bg-dark text-white border-secondary" rows="4"></textarea>
                            </div>

                        </div>

                        <button type="submit" class="btn btn-primary btn-lg px-5">
                            Save Profile
                        </button>

                    </form>
                </div>
            </div>
        </div>

        <!-- RIGHT SIDE: Live Capacity + Gamification -->
        <div class="col-lg-4">

            <!-- 1. LIVE GYM CAPACITY -->
            <div class="card border-0 rounded-4 p-4 text-center mb-4"
                 style="background: rgba(15,23,42,0.9); border: 1px solid rgba(255,255,255,0.06) !important;">

                <h5 class="fw-bold mb-3" style="color:#93c5fd;">
                    🔴 Live Gym Capacity
                </h5>

                <div class="progress mb-3"
                     style="height: 28px; border-radius: 20px; background: rgba(255,255,255,0.08);">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                         id="capacityBar"
                         role="progressbar"
                         style="width: 0%; font-size: 14px; font-weight: bold; border-radius: 20px;"
                         aria-valuenow="0"
                         aria-valuemin="0"
                         aria-valuemax="100">
                        0%
                    </div>
                </div>

                <p class="mb-0 text-light">
                    Status: <span id="capacityBadge" class="badge bg-success p-2">Loading...</span>
                </p>
            </div>

            <!-- 2. GAMIFICATION & QR PASS -->
            <div class="card border-0 rounded-4 p-4 text-center"
                 style="background: rgba(15,23,42,0.9); border: 1px solid rgba(255,255,255,0.06) !important;">

                <h5 class="fw-bold mb-3" style="color:white;">
                    🔥 My Fitness Dashboard
                </h5>
                <hr style="border-color: rgba(255,255,255,0.1);" />

                <!-- Workout Streak -->
                <div class="mb-4">
                    <div style="font-size: 2.5rem;">⚡</div>
                    <h5 class="fw-bold mb-0 text-white">
                        @(ViewBag.WorkoutStreak ?? 5) Day Streak
                    </h5>
                    <small class="text-muted">Keep it up! Consistency is key.</small>
                </div>

                <!-- Earned Badges -->
                <div class="mb-4 text-start">
                    <h6 class="fw-bold text-white mb-2">🏅 Earned Badges:</h6>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-warning text-dark p-2">🏋️ Early Bird</span>
                        <span class="badge bg-info text-white p-2">🔥 Cardio King</span>
                        <span class="badge bg-success text-white p-2">💪 Gym Starter</span>
                    </div>
                </div>

                <hr style="border-color: rgba(255,255,255,0.1);" />

                <!-- QR Guest Day Pass -->
                <div class="my-3">
                    <h6 class="fw-bold text-white mb-2">🎫 Digital Entry Pass</h6>
                    <p class="text-muted small">
                        Scan this at the reception for quick check-in.
                    </p>

                    <div class="p-3 d-inline-block rounded-3"
                         style="background: white;">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=NexFit-Member-@(Model?.Email ?? "Guest")"
                             alt="QR Code Pass"
                             class="img-fluid"
                             style="max-width: 150px;" />
                    </div>

                    <div class="mt-2 small fw-bold" style="color:#93c5fd;">
                        ID: NEXFIT-@(Model?.Email?.ToUpper() ?? "MEMBER")
                    </div>
                </div>

            </div>

        </div>

    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    (function () {
    const conn = new signalR.HubConnectionBuilder()
    .withUrl("/gymHub")
    .withAutomaticReconnect()
    .build();

    conn.on("ReceiveCapacityUpdate", function (capacity) {
    updateCapacity(capacity);
    });

    conn.start().catch(err => console.error("GymHub error:", err));

    function updateCapacity(value) {
    const bar   = document.getElementById("capacityBar");
    const badge = document.getElementById("capacityBadge");
    if (!bar || !badge) return;

    bar.style.width = value + "%";
    bar.setAttribute("aria-valuenow", value);
    bar.textContent = value + "%";

    if (value < 50) {
    bar.className     = "progress-bar progress-bar-striped progress-bar-animated bg-success";
    badge.className   = "badge bg-success p-2";
    badge.textContent = "Spacious ✅";
    } else if (value < 85) {
    bar.className     = "progress-bar progress-bar-striped progress-bar-animated bg-warning";
    badge.className   = "badge bg-warning text-dark p-2";
    badge.textContent = "Moderate ⚠️";
    } else {
    bar.className     = "progress-bar progress-bar-striped progress-bar-animated bg-danger";
    badge.className   = "badge bg-danger p-2";
    badge.textContent = "Crowded! 🚨";
    }
    }

    updateCapacity(@(ViewBag.CapacityPercentage ?? 0));
    })();
</script>