@model NexFit.Models.ApplicationUser

@{
    ViewData["Title"] = "Attendance";
}

<div class="container py-5">

    <h2 class="mb-4 text-white">
        Attendance Dashboard
    </h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card bg-dark text-white p-4 rounded-4 mb-4">

        <h4>Total Visits: @Model.TotalVisits</h4>

        <h4>Workout Streak: @Model.WorkoutStreak</h4>

        <h4>
            Current Status:
            @(Model.IsInsideGym ? "Inside Gym" : "Outside Gym")
        </h4>

    </div>

    <div class="d-flex gap-3 mb-5">

        <form asp-action="CheckIn" method="post">
            @Html.AntiForgeryToken()

            <button class="btn btn-success">
                Mark Attendance
            </button>
        </form>

        <form asp-action="CheckOut" method="post">
            @Html.AntiForgeryToken()

            <button class="btn btn-danger">
                Check Out
            </button>
        </form>

    </div>

    <div class="card bg-dark text-white p-4 rounded-4">

        <h4 class="mb-4">
            Attendance History
        </h4>

        @if (Model.AttendanceLogs == null || Model.AttendanceLogs.Count == 0)
        {
            <p>No attendance found.</p>
        }
        else
        {
            <ul class="list-group">

                @foreach (var log in Model.AttendanceLogs.OrderByDescending(x => x))
                {
                    <li class="list-group-item">
                        @log.ToLocalTime()
                    </li>
                }

            </ul>
        }

    </div>

</div>