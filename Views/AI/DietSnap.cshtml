    .log-item-calories { color: #f97316; font-weight: 800; font-size: 1rem; white-space: nowrap; margin-left: 1rem; }
    .log-item-delete { background: none; border: none; color: #475569; cursor: pointer; font-size: 1rem; margin-left: 0.5rem; padding: 0; }
