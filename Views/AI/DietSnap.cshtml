@{
    ViewData["Title"] = "Smart Diet Snap";
}

<div class="ai-container">
    <div class="ai-card">
        <h2 class="ai-title">🍎 Smart Diet Snap</h2>
        <p class="ai-subtitle">Upload a food photo — AI will estimate calories and macros instantly.</p>

        <div class="upload-zone" id="uploadZone">
            <input type="file" id="foodInput" accept="image/*" onchange="previewAndAnalyze(this)" />
            <label for="foodInput">
                <span class="upload-icon">📸</span>
                <span id="uploadText">Click to upload food photo</span>
                <span class="upload-hint">JPG, PNG — max 5MB</span>
            </label>
        </div>

        <div id="previewSection" style="display:none; text-align:center; margin-top:1rem;">
            <img id="foodPreview" style="max-height:200px; border-radius:12px;" />
        </div>

        <div id="loadingBox" style="display:none;" class="loading-box">
            <div class="spinner"></div>
            <span>Analyzing your meal...</span>
        </div>

        <div id="resultCard" style="display:none;" class="result-card">
            <h5 id="foodName"></h5>
            <div class="macro-grid">
                <div class="macro-item" style="background:#FFF3E0">
                    <span class="macro-value" id="calories"></span>
                    <span class="macro-label">kcal</span>
                </div>
                <div class="macro-item" style="background:#E8F5E9">
                    <span class="macro-value" id="protein"></span>
                    <span class="macro-label">Protein</span>
                </div>
                <div class="macro-item" style="background:#E3F2FD">
                    <span class="macro-value" id="carbs"></span>
                    <span class="macro-label">Carbs</span>
                </div>
                <div class="macro-item" style="background:#FCE4EC">
                    <span class="macro-value" id="fat"></span>
                    <span class="macro-label">Fat</span>
                </div>
            </div>
            <p id="servingSize" class="serving-info"></p>
        </div>
    </div>
</div>

<style>
    .ai-container { max-width: 680px; margin: 2rem auto; padding: 0 1rem; }
    .ai-card { background: white; border-radius: 16px; padding: 2rem; box-shadow: 0 2px 20px rgba(0,0,0,0.08); }
    .ai-title { color: #6C47FF; font-size: 1.5rem; font-weight: 700; }
    .ai-subtitle { color: #6B7280; margin-bottom: 1.5rem; }
    .upload-zone { border: 2px dashed #6C47FF; border-radius: 12px; padding: 2rem; text-align: center; cursor: pointer; position: relative; }
    .upload-zone input { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
    .upload-zone label { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; color: #6B7280; pointer-events: none; }
    .upload-icon { font-size: 2.5rem; }
    .upload-hint { font-size: 0.8rem; color: #aaa; }
    .loading-box { display: flex; align-items: center; gap: 0.75rem; background: #F3F0FF; border-radius: 10px; padding: 1rem; margin-top: 1rem; color: #6C47FF; }
    .spinner { width: 20px; height: 20px; border: 2px solid rgba(108,71,255,0.2); border-top-color: #6C47FF; border-radius: 50%; animation: spin 0.8s linear infinite; }
    @@keyframes spin { to { transform: rotate(360deg); } }
    .result-card { background: #F9FAFB; border-radius: 12px; padding: 1.25rem; margin-top: 1rem; border: 1px solid #E8E8F0; }
    .result-card h5 { font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem; }
    .macro-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; margin-bottom: 0.75rem; }
    .macro-item { text-align: center; padding: 0.75rem 0.5rem; border-radius: 10px; display: flex; flex-direction: column; gap: 0.2rem; }
    .macro-value { font-size: 1.3rem; font-weight: 700; }
    .macro-label { font-size: 0.75rem; color: #6B7280; text-transform: uppercase; }
    .serving-info { font-size: 0.85rem; color: #6B7280; margin: 0; }
</style>

<script>
    function previewAndAnalyze(input) {
        const file = input.files[0];
        if (!file) return;

        document.getElementById('uploadText').textContent = file.name;

        const reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById('foodPreview').src = e.target.result;
            document.getElementById('previewSection').style.display = 'block';
        };
        reader.readAsDataURL(file);

        document.getElementById('loadingBox').style.display = 'flex';
        document.getElementById('resultCard').style.display = 'none';

        const formData = new FormData();
        formData.append('image', file);

        fetch('/AI/AnalyzeFood', { method: 'POST', body: formData })
            .then(r => r.json())
            .then(data => {
                document.getElementById('loadingBox').style.display = 'none';
                document.getElementById('foodName').textContent = data.foodName;
                document.getElementById('calories').textContent = data.calories;
                document.getElementById('protein').textContent = data.proteinG + 'g';
                document.getElementById('carbs').textContent = data.carbsG + 'g';
                document.getElementById('fat').textContent = data.fatG + 'g';
                document.getElementById('servingSize').textContent = 'Serving: ' + data.servingSize;
                document.getElementById('resultCard').style.display = 'block';
            });
    }
</script>