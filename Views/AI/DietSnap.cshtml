@{
    ViewData["Title"] = "Smart Diet Snap";
}

<!-- ===================== DIET SNAP SECTION ===================== -->
<div class="ai-container">
    <div class="ai-card">
        <h2 class="ai-title">🍎 Smart Diet Snap</h2>
        <p class="ai-subtitle">Upload a photo of your meal. AI will estimate calories and macros instantly.</p>

        <div class="upload-zone">
            <input type="file" id="foodInput" accept="image/*" onchange="previewAndAnalyze(this)" />
            <label for="foodInput">
                <span class="upload-icon">📸</span>
                <span id="uploadText">Click to upload food photo</span>
                <span class="upload-hint">JPG, PNG — max 5MB</span>
            </label>
        </div>

        <div id="previewSection" style="display:none; text-align:center; margin-top:1rem;">
            <img id="foodPreview" style="max-height:200px; border-radius:12px;" />
        </div>

        <div id="loadingBox" style="display:none;" class="loading-box">
            <div class="spinner"></div>
            <span>Analyzing your meal...</span>
        </div>

        <div id="resultCard" style="display:none;" class="result-card">
            <h5 id="foodName"></h5>
            <div class="macro-grid">
                <div class="macro-item" style="background:#FFF3E0">
                    <span class="macro-value" id="calories"></span>
                    <span class="macro-label">kcal</span>
                </div>
                <div class="macro-item" style="background:#E8F5E9">
                    <span class="macro-value" id="protein"></span>
                    <span class="macro-label">Protein</span>
                </div>
                <div class="macro-item" style="background:#E3F2FD">
                    <span class="macro-value" id="carbs"></span>
                    <span class="macro-label">Carbs</span>
                </div>
                <div class="macro-item" style="background:#FCE4EC">
                    <span class="macro-value" id="fat"></span>
                    <span class="macro-label">Fat</span>
                </div>
            </div>
            <p id="servingSize" class="serving-info"></p>
            <!-- Add to Calorie Counter Button -->
            <button class="add-to-log-btn" id="addToLogBtn" onclick="addToLog()" style="display:none;">
                ➕ Add to Daily Log
            </button>
        </div>
    </div>
</div>

<!-- ===================== BMI CALCULATOR SECTION ===================== -->
<div class="bmi-container">
    <div class="bmi-card">
        <div class="bmi-header">
            <span class="bmi-icon">⚖️</span>
            <div>
                <h2 class="bmi-title">BMI Calculator</h2>
                <p class="bmi-subtitle">Enter your height and weight to calculate your Body Mass Index.</p>
            </div>
        </div>
        <div class="bmi-input-row">
            <div class="bmi-field">
                <label class="bmi-label">Height</label>
                <div class="bmi-input-wrap">
                    <input type="number" id="bmiHeight" class="bmi-input" placeholder="e.g. 170" min="50" max="250" />
                    <span class="bmi-unit">cm</span>
                </div>
                <small class="bmi-hint">50 – 250 cm</small>
            </div>
            <div class="bmi-field">
                <label class="bmi-label">Weight</label>
                <div class="bmi-input-wrap">
                    <input type="number" id="bmiWeight" class="bmi-input" placeholder="e.g. 70" min="10" max="300" />
                    <span class="bmi-unit">kg</span>
                </div>
                <small class="bmi-hint">10 – 300 kg</small>
            </div>
            <div class="bmi-field">
                <label class="bmi-label">Age</label>
                <div class="bmi-input-wrap">
                    <input type="number" id="bmiAge" class="bmi-input" placeholder="e.g. 25" min="1" max="120" />
                    <span class="bmi-unit">yrs</span>
                </div>
                <small class="bmi-hint">1 – 120 yrs</small>
            </div>
        </div>
        <div class="bmi-gender-row">
            <button class="bmi-gender-btn" id="btnMale" onclick="selectGender('Male')">♂ Male</button>
            <button class="bmi-gender-btn bmi-gender-active" id="btnFemale" onclick="selectGender('Female')">♀ Female</button>
        </div>
        <div id="bmiError" class="bmi-error" style="display:none;"></div>
        <button class="bmi-calc-btn" onclick="calculateBMI()">Calculate BMI</button>
        <div id="bmiResult" class="bmi-result" style="display:none;">
            <div class="bmi-result-top">
                <div class="bmi-result-value-wrap">
                    <span class="bmi-result-label">Your BMI</span>
                    <span class="bmi-result-value" id="bmiValue">--</span>
                    <span class="bmi-result-category" id="bmiCategory">--</span>
                </div>
                <div class="bmi-result-info">
                    <div class="bmi-info-row">
                        <span class="bmi-info-label">Ideal Weight Range</span>
                        <span class="bmi-info-val" id="idealWeight">--</span>
                    </div>
                    <div class="bmi-info-row">
                        <span class="bmi-info-label">Daily Calories (BMR)</span>
                        <span class="bmi-info-val" id="dailyCalories">--</span>
                    </div>
                    <div class="bmi-info-row">
                        <span class="bmi-info-label">Gender</span>
                        <span class="bmi-info-val" id="genderDisplay">--</span>
                    </div>
                </div>
            </div>
            <div class="bmi-bar-wrap">
                <div class="bmi-bar">
                    <div class="bmi-bar-segment bmi-seg-under">Underweight<br/>&lt;18.5</div>
                    <div class="bmi-bar-segment bmi-seg-normal">Normal<br/>18.5–24.9</div>
                    <div class="bmi-bar-segment bmi-seg-over">Overweight<br/>25–29.9</div>
                    <div class="bmi-bar-segment bmi-seg-obese">Obese<br/>&ge;30</div>
                </div>
                <div class="bmi-marker-wrap">
                    <div class="bmi-marker" id="bmiMarker">▲</div>
                </div>
            </div>
            <p class="bmi-advice" id="bmiAdvice"></p>
        </div>
    </div>
</div>

<!-- ===================== CALORIE COUNTER SECTION ===================== -->
<div class="calorie-container">
    <div class="calorie-card">

        <div class="calorie-header">
            <span class="calorie-icon">🔥</span>
            <div>
                <h2 class="calorie-title">Daily Calorie Counter</h2>
                <p class="calorie-subtitle">Track everything you eat today. Add meals manually or from Diet Snap above.</p>
            </div>
        </div>

        <!-- Daily Goal -->
        <div class="goal-row">
            <label class="bmi-label">Daily Calorie Goal</label>
            <div class="goal-input-wrap">
                <input type="number" id="calorieGoal" class="bmi-input" value="2000" min="500" max="5000" />
                <span class="bmi-unit">kcal</span>
            </div>
        </div>

        <!-- Progress Bar -->
        <div class="progress-section">
            <div class="progress-labels">
                <span id="consumedLabel" style="color:#38bdf8; font-weight:700;">0 kcal consumed</span>
                <span id="remainingLabel" style="color:#94a3b8;">2000 kcal remaining</span>
            </div>
            <div class="calorie-progress-bar">
                <div class="calorie-progress-fill" id="progressFill" style="width:0%"></div>
            </div>
            <div class="macro-summary-row">
                <div class="macro-summary-item">
                    <span class="macro-summary-value" id="totalProtein">0g</span>
                    <span class="macro-summary-label">Protein</span>
                </div>
                <div class="macro-summary-item">
                    <span class="macro-summary-value" id="totalCarbs">0g</span>
                    <span class="macro-summary-label">Carbs</span>
                </div>
                <div class="macro-summary-item">
                    <span class="macro-summary-value" id="totalFat">0g</span>
                    <span class="macro-summary-label">Fat</span>
                </div>
            </div>
        </div>

        <!-- Manual Add -->
        <div class="manual-add-section">
            <h5 class="section-label">➕ Add Meal Manually</h5>
            <div class="manual-add-row">
                <input type="text" id="manualFoodName" class="manual-input" placeholder="Food name (e.g. Rice, Egg)" />
                <input type="number" id="manualCalories" class="manual-input small" placeholder="Calories" min="0" />
                <input type="number" id="manualProtein" class="manual-input small" placeholder="Protein g" min="0" />
                <input type="number" id="manualCarbs" class="manual-input small" placeholder="Carbs g" min="0" />
                <input type="number" id="manualFat" class="manual-input small" placeholder="Fat g" min="0" />
                <button class="add-manual-btn" onclick="addManualEntry()">Add</button>
            </div>
        </div>

        <!-- Food Log -->
        <div class="food-log-section">
            <div class="log-header-row">
                <h5 class="section-label">📋 Today's Food Log</h5>
                <button class="clear-log-btn" onclick="clearLog()">🗑 Clear All</button>
            </div>
            <div id="foodLogList">
                <div class="empty-log">No meals logged yet. Upload a food photo or add manually above!</div>
            </div>
        </div>

    </div>
</div>

<!-- ===================== STYLES ===================== -->
<style>
    /* ---- DIET SNAP ---- */
