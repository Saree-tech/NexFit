    .bmi-field { display: flex; flex-direction: column; gap: 0.4rem; }
    .bmi-label { color: #94a3b8; font-size: 0.85rem; font-weight: 500; }
    .bmi-input-wrap { display: flex; align-items: center; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); border-radius: 10px; overflow: hidden; transition: border-color .2s; }
    .bmi-input-wrap:focus-within { border-color: #38bdf8; }
    .bmi-input { background: transparent; border: none; outline: none; color: white; font-size: 1.1rem; font-weight: 600; padding: 0.65rem 0.75rem; width: 100%; }
    .bmi-input::placeholder { color: #475569; font-weight: 400; }
    .bmi-input::-webkit-inner-spin-button, .bmi-input::-webkit-outer-spin-button { -webkit-appearance: none; }
    .bmi-unit { color: #64748b; font-size: 0.8rem; padding-right: 0.75rem; white-space: nowrap; }
    .bmi-hint { color: #475569; font-size: 0.72rem; }
    .bmi-gender-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.2rem; }
    .bmi-gender-btn { background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.1); color: #94a3b8; border-radius: 12px; padding: 0.7rem; font-size: 0.95rem; font-weight: 600; cursor: pointer; transition: all .2s; }
    .bmi-gender-btn:hover { background: rgba(56,189,248,.08); border-color: rgba(56,189,248,.3); color: #38bdf8; }
    .bmi-gender-active { background: linear-gradient(135deg, rgba(56,189,248,.18), rgba(99,102,241,.18)) !important; border-color: #38bdf8 !important; color: #38bdf8 !important; }
    .bmi-error { background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.3); color: #f87171; border-radius: 10px; padding: 0.75rem 1rem; margin-bottom: 1rem; font-size: 0.9rem; }
    .bmi-calc-btn { width: 100%; background: linear-gradient(135deg, #1d4ed8, #38bdf8); color: white; border: none; border-radius: 12px; padding: 0.85rem; font-size: 1rem; font-weight: 700; cursor: pointer; transition: all .2s; }
    .bmi-calc-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(56,189,248,.3); }
    .bmi-result { margin-top: 1.5rem; animation: fadeIn .4s ease; }
    @@keyframes fadeIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
    .bmi-result-top { display: flex; gap: 1.5rem; align-items: flex-start; margin-bottom: 1.25rem; flex-wrap: wrap; }
    .bmi-result-value-wrap { display: flex; flex-direction: column; align-items: center; background: rgba(56,189,248,.08); border: 1px solid rgba(56,189,248,.2); border-radius: 16px; padding: 1.25rem 1.75rem; min-width: 130px; }
    .bmi-result-label { color: #94a3b8; font-size: 0.8rem; font-weight: 500; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 0.3rem; }
    .bmi-result-value { font-size: 2.8rem; font-weight: 800; color: white; line-height: 1; }
    .bmi-result-category { font-size: 0.9rem; font-weight: 700; margin-top: 0.4rem; border-radius: 20px; padding: 0.2rem 0.8rem; }
    .bmi-result-info { flex: 1; display: flex; flex-direction: column; gap: 0.75rem; justify-content: center; }
    .bmi-info-row { display: flex; justify-content: space-between; align-items: center; padding: 0.55rem 0.9rem; background: rgba(255,255,255,.04); border-radius: 10px; }
    .bmi-info-label { color: #94a3b8; font-size: 0.85rem; }
    .bmi-info-val { color: white; font-weight: 700; font-size: 0.9rem; }
    .bmi-bar-wrap { margin: 0.5rem 0 1rem; }
    .bmi-bar { display: flex; border-radius: 8px; overflow: hidden; height: 32px; }
    .bmi-bar-segment { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 0.6rem; font-weight: 700; line-height: 1.2; color: rgba(0,0,0,.7); }
    .bmi-seg-under { background: #60a5fa; }
    .bmi-seg-normal { background: #4ade80; }
    .bmi-seg-over { background: #facc15; }
    .bmi-seg-obese { background: #f87171; }
    .bmi-marker-wrap { position: relative; height: 20px; }
    .bmi-marker { position: absolute; font-size: 1rem; color: white; transform: translateX(-50%); top: 2px; transition: left .4s ease; text-shadow: 0 0 6px rgba(0,0,0,.8); }
    .bmi-advice { color: #94a3b8; font-size: 0.88rem; line-height: 1.6; margin: 0; padding: 0.9rem; background: rgba(255,255,255,.03); border-radius: 10px; border-left: 3px solid #38bdf8; }

    /* ---- CALORIE COUNTER ---- */
    .calorie-container { max-width: 680px; margin: 0 auto 3rem; padding: 0 1rem; }
    .calorie-card { background: linear-gradient(145deg, #0d1b2e, #0f2540); border: 1px solid rgba(255,255,255,.08); border-radius: 20px; padding: 2rem; box-shadow: 0 4px 30px rgba(0,0,0,.4); }
    .calorie-header { display: flex; align-items: flex-start; gap: 1rem; margin-bottom: 1.5rem; }
    .calorie-icon { font-size: 2rem; }
    .calorie-title { color: #f97316; font-size: 1.4rem; font-weight: 700; margin: 0; }
    .calorie-subtitle { color: #94a3b8; font-size: 0.9rem; margin: 0.2rem 0 0; }
    .goal-row { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.2rem; flex-wrap: wrap; }
    .goal-input-wrap { display: flex; align-items: center; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); border-radius: 10px; overflow: hidden; width: 160px; }
    .progress-section { margin-bottom: 1.5rem; }
    .progress-labels { display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.9rem; }
    .calorie-progress-bar { height: 14px; background: rgba(255,255,255,.08); border-radius: 999px; overflow: hidden; margin-bottom: 1rem; }
    .calorie-progress-fill { height: 100%; background: linear-gradient(135deg, #f97316, #fbbf24); border-radius: 999px; transition: width .4s ease; }
    .macro-summary-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
    .macro-summary-item { text-align: center; background: rgba(255,255,255,.04); border-radius: 10px; padding: 0.6rem; }
    .macro-summary-value { display: block; color: white; font-size: 1.1rem; font-weight: 700; }
    .macro-summary-label { color: #64748b; font-size: 0.75rem; text-transform: uppercase; }
    .section-label { color: #cbd5e1; font-size: 0.95rem; font-weight: 700; margin: 0 0 0.75rem; }
    .manual-add-section { margin-bottom: 1.5rem; }
    .manual-add-row { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .manual-input { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); border-radius: 8px; color: white; padding: 0.5rem 0.75rem; font-size: 0.85rem; outline: none; flex: 1; min-width: 100px; }
    .manual-input.small { max-width: 90px; flex: 0 0 90px; }
    .manual-input::placeholder { color: #475569; }
    .add-manual-btn { background: linear-gradient(135deg, #f97316, #fbbf24); color: white; border: none; border-radius: 8px; padding: 0.5rem 1rem; font-weight: 700; cursor: pointer; white-space: nowrap; }
