    @@media (max-width: 600px) {
        .bmi-input-row { grid-template-columns: 1fr; }
        .bmi-result-top { flex-direction: column; }
        .bmi-result-value-wrap { width: 100%; }
        .manual-add-row { flex-direction: column; }
        .manual-input.small { max-width: 100%; flex: 1; }
    }
</style>

<!-- ===================== SCRIPTS ===================== -->
<script>

    /* ==================== DIET SNAP ==================== */
    let lastAnalyzed = null;

    function previewAndAnalyze(input) {
        const file = input.files[0];
        if (!file) return;
        if (file.size > 5 * 1024 * 1024) { alert('File too large! Please upload under 5MB.'); return; }
        document.getElementById('uploadText').textContent = file.name;
        const reader = new FileReader();
        reader.onload = e => {
            document.getElementById('foodPreview').src = e.target.result;
            document.getElementById('previewSection').style.display = 'block';
        };
        reader.readAsDataURL(file);
        document.getElementById('loadingBox').style.display = 'flex';
        document.getElementById('resultCard').style.display = 'none';
        document.getElementById('addToLogBtn').style.display = 'none';
        const formData = new FormData();
        formData.append('image', file);
        fetch('/AI/AnalyzeFood', { method: 'POST', body: formData })
            .then(r => r.json())
            .then(data => {
                document.getElementById('loadingBox').style.display = 'none';
                document.getElementById('foodName').textContent = data.foodName || 'Food Item Detected';
                document.getElementById('calories').textContent = data.calories || '0';
                document.getElementById('protein').textContent = (data.proteinG || '0') + 'g';
                document.getElementById('carbs').textContent = (data.carbsG || '0') + 'g';
                document.getElementById('fat').textContent = (data.fatG || '0') + 'g';
                document.getElementById('servingSize').textContent = 'Serving: ' + (data.servingSize || '1 serving');
                document.getElementById('resultCard').style.display = 'block';
                document.getElementById('addToLogBtn').style.display = 'block';
                lastAnalyzed = {
                    name: data.foodName || 'Food Item',
                    calories: parseInt(data.calories) || 0,
                    protein: parseFloat(data.proteinG) || 0,
                    carbs: parseFloat(data.carbsG) || 0,
                    fat: parseFloat(data.fatG) || 0
                };
            })
            .catch(() => {
                document.getElementById('loadingBox').style.display = 'none';
                alert('Error analyzing food. Please try again.');
            });
    }

    /* ==================== BMI CALCULATOR ==================== */
    let selectedGender = 'Female';

    function selectGender(gender) {
        selectedGender = gender;
        document.getElementById('btnMale').classList.remove('bmi-gender-active');
        document.getElementById('btnFemale').classList.remove('bmi-gender-active');
        document.getElementById('btn' + gender).classList.add('bmi-gender-active');
    }

    function showError(msg) {
        const el = document.getElementById('bmiError');
        el.textContent = msg;
        el.style.display = 'block';
        document.getElementById('bmiResult').style.display = 'none';
    }

    function hideError() { document.getElementById('bmiError').style.display = 'none'; }

    function calculateBMI() {
        hideError();
        const heightVal = document.getElementById('bmiHeight').value.trim();
        const weightVal = document.getElementById('bmiWeight').value.trim();
        const ageVal = document.getElementById('bmiAge').value.trim();
        const height = parseFloat(heightVal);
        const weight = parseFloat(weightVal);
        const age = parseFloat(ageVal);
        if (heightVal === '' || weightVal === '' || ageVal === '') { showError('Please fill in all fields — Height, Weight, and Age.'); return; }
        if (isNaN(height) || isNaN(weight) || isNaN(age)) { showError('Please enter valid numeric values.'); return; }
        if (height < 50 || height > 250) { showError('Height must be between 50 and 250 cm.'); return; }
        if (weight < 10 || weight > 300) { showError('Weight must be between 10 and 300 kg.'); return; }
        if (age < 1 || age > 120) { showError('Age must be between 1 and 120 years.'); return; }
        const heightM = height / 100.0;
        const bmi = weight / (heightM * heightM);
        const bmiRounded = Math.round(bmi * 10) / 10;
        let category, categoryColor, advice;
        if (bmi < 18.5) { category = 'Underweight'; categoryColor = '#60a5fa'; advice = 'Your BMI suggests you are underweight. Consider a calorie-dense, nutrient-rich diet and consult a nutritionist for a personalised meal plan.'; }
        else if (bmi < 25) { category = 'Normal Weight'; categoryColor = '#4ade80'; advice = 'Great! Your BMI is in the healthy range. Maintain your current lifestyle with balanced nutrition and regular exercise.'; }
        else if (bmi < 30) { category = 'Overweight'; categoryColor = '#facc15'; advice = 'Your BMI is slightly above normal. A combination of regular cardio exercise and a balanced diet can help you reach a healthier weight.'; }
        else { category = 'Obese'; categoryColor = '#f87171'; advice = 'Your BMI indicates obesity. It is recommended to consult a doctor or fitness professional for a structured weight-loss programme.'; }
        const idealMin = Math.round(18.5 * heightM * heightM * 10) / 10;
        const idealMax = Math.round(24.9 * heightM * heightM * 10) / 10;
        let bmr = selectedGender === 'Male' ? (10 * weight) + (6.25 * height) - (5 * age) + 5 : (10 * weight) + (6.25 * height) - (5 * age) - 161;
        const tdee = Math.round(bmr * 1.375);
        const markerPct = Math.min(Math.max(((bmi - 10) / 30) * 100, 2), 98);
        document.getElementById('bmiValue').textContent = bmiRounded;
        document.getElementById('bmiCategory').textContent = category;
        document.getElementById('bmiCategory').style.background = categoryColor + '22';
        document.getElementById('bmiCategory').style.color = categoryColor;
        document.getElementById('idealWeight').textContent = idealMin + ' – ' + idealMax + ' kg';
        document.getElementById('dailyCalories').textContent = tdee + ' kcal/day';
        document.getElementById('genderDisplay').textContent = selectedGender;
        document.getElementById('bmiAdvice').textContent = advice;
        document.getElementById('bmiMarker').style.left = markerPct + '%';
        document.getElementById('bmiResult').style.display = 'block';
        document.getElementById('bmiResult').scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        // Auto-set calorie goal from BMR
        document.getElementById('calorieGoal').value = tdee;
        updateProgress();
    }

    /* ==================== CALORIE COUNTER ==================== */
    let foodLog = [];

    function addToLog() {
        if (!lastAnalyzed) return;
        addEntry(lastAnalyzed.name, lastAnalyzed.calories, lastAnalyzed.protein, lastAnalyzed.carbs, lastAnalyzed.fat);
        document.getElementById('addToLogBtn').textContent = '✅ Added to Log!';
        setTimeout(() => { document.getElementById('addToLogBtn').textContent = '➕ Add to Daily Log'; }, 2000);
    }

    function addManualEntry() {
        const name = document.getElementById('manualFoodName').value.trim();
        const cal = parseInt(document.getElementById('manualCalories').value) || 0;
        const pro = parseFloat(document.getElementById('manualProtein').value) || 0;
        const carb = parseFloat(document.getElementById('manualCarbs').value) || 0;
        const fat = parseFloat(document.getElementById('manualFat').value) || 0;
        if (!name) { alert('Please enter a food name.'); return; }
        if (cal <= 0) { alert('Please enter calories.'); return; }
        addEntry(name, cal, pro, carb, fat);
        document.getElementById('manualFoodName').value = '';
        document.getElementById('manualCalories').value = '';
        document.getElementById('manualProtein').value = '';
        document.getElementById('manualCarbs').value = '';
        document.getElementById('manualFat').value = '';
    }

    function addEntry(name, calories, protein, carbs, fat) {
        const id = Date.now();
        foodLog.push({ id, name, calories, protein, carbs, fat });
        renderLog();
        updateProgress();
    }

    function deleteEntry(id) {
        foodLog = foodLog.filter(e => e.id !== id);
        renderLog();
        updateProgress();
    }

    function clearLog() {
        if (foodLog.length === 0) return;
        if (confirm('Clear all food entries?')) {
            foodLog = [];
            renderLog();
            updateProgress();
        }
    }

    function renderLog() {
        const list = document.getElementById('foodLogList');
        if (foodLog.length === 0) {
            list.innerHTML = '<div class="empty-log">No meals logged yet. Upload a food photo or add manually above!</div>';
            return;
        }
        list.innerHTML = foodLog.map(e => `
            <div class="log-item">
                <div>
                    <div class="log-item-name">${e.name}</div>
                    <div class="log-item-macros">P: ${e.protein}g &nbsp; C: ${e.carbs}g &nbsp; F: ${e.fat}g</div>
                </div>
                <div style="display:flex; align-items:center;">
                    <span class="log-item-calories">${e.calories} kcal</span>
                    <button class="log-item-delete" onclick="deleteEntry(${e.id})">🗑</button>
                </div>
            </div>
        `).join('');
    }

    function updateProgress() {
        const goal = parseInt(document.getElementById('calorieGoal').value) || 2000;
        const total = foodLog.reduce((s, e) => s + e.calories, 0);
        const totalProtein = foodLog.reduce((s, e) => s + e.protein, 0).toFixed(1);
        const totalCarbs = foodLog.reduce((s, e) => s + e.carbs, 0).toFixed(1);
        const totalFat = foodLog.reduce((s, e) => s + e.fat, 0).toFixed(1);
        const pct = Math.min((total / goal) * 100, 100);
        const remaining = Math.max(goal - total, 0);
        document.getElementById('consumedLabel').textContent = total + ' kcal consumed';
        document.getElementById('remainingLabel').textContent = remaining + ' kcal remaining';
        document.getElementById('progressFill').style.width = pct + '%';
        document.getElementById('progressFill').style.background = pct >= 100
            ? 'linear-gradient(135deg, #ef4444, #f87171)'
            : 'linear-gradient(135deg, #f97316, #fbbf24)';
        document.getElementById('totalProtein').textContent = totalProtein + 'g';
        document.getElementById('totalCarbs').textContent = totalCarbs + 'g';
        document.getElementById('totalFat').textContent = totalFat + 'g';
    }

    document.getElementById('calorieGoal').addEventListener('input', updateProgress);

</script>