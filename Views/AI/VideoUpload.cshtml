@{
    ViewData["Title"] = "Video Posture Upload";
}

<div class="ai-container">
    <div class="ai-card">
        <h2 class="ai-title">🏋️ Video Posture Upload</h2>
        <p class="ai-subtitle">Upload a workout video — AI will analyze your exercise form.</p>

        <div class="upload-zone">
            <input type="file" id="videoInput" accept=".mp4,.webm,.mov" onchange="handleVideo(this)" />
            <label for="videoInput">
                <span class="upload-icon">🎬</span>
                <span id="videoText">Click to upload workout video</span>
                <span class="upload-hint">MP4, WebM, MOV — max 20MB</span>
            </label>
        </div>

        <div id="videoPreview" style="display:none; margin-top:1rem; text-align:center;">
            <video id="previewVideo" controls style="max-width:100%; border-radius:12px;"></video>
            <br />
            <button onclick="analyzePosture()" class="ai-btn mt-2">Analyze Posture with AI</button>
        </div>

        <div id="loadingBox" style="display:none;" class="loading-box">
            <div class="spinner"></div>
            <span>AI is analyzing your form...</span>
        </div>

        <div id="feedbackCard" style="display:none;" class="feedback-card">
            <h5>AI Posture Feedback</h5>
            <pre id="feedbackText" style="white-space:pre-wrap; font-family:inherit;"></pre>
        </div>
    </div>
</div>

<style>
.ai-container { max-width: 680px; margin: 2rem auto; padding: 0 1rem; }
.ai-card { background: white; border-radius: 16px; padding: 2rem; box-shadow: 0 2px 20px rgba(0,0,0,0.08); }
.ai-title { color: #6C47FF; font-size: 1.5rem; font-weight: 700; }
.ai-subtitle { color: #6B7280; margin-bottom: 1.5rem; }
.upload-zone { border: 2px dashed #6C47FF; border-radius: 12px; padding: 2rem; text-align: center; cursor: pointer; position: relative; }
.upload-zone input { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
.upload-zone label { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; color: #6B7280; pointer-events: none; }
.upload-icon { font-size: 2.5rem; }
.upload-hint { font-size: 0.8rem; color: #aaa; }
.ai-btn { background: #6C47FF; color: white; border: none; border-radius: 10px; padding: 0.65rem 1.5rem; font-size: 0.95rem; cursor: pointer; margin-top: 0.75rem; }
.ai-btn:hover { opacity: 0.9; }
.loading-box { display: flex; align-items: center; gap: 0.75rem; background: #F3F0FF; border-radius: 10px; padding: 1rem; margin-top: 1rem; color: #6C47FF; }
.spinner { width: 20px; height: 20px; border: 2px solid rgba(108,71,255,0.2); border-top-color: #6C47FF; border-radius: 50%; animation: spin 0.8s linear infinite; }
@@keyframes spin { to { transform: rotate(360deg); } }
.feedback-card { background: #F0FDF8; border: 1px solid #A7F3D0; border-radius: 12px; padding: 1.25rem; margin-top: 1rem; }
.feedback-card h5 { color: #065F46; font-weight: 600; margin-bottom: 0.75rem; }
.mt-2 { margin-top: 0.5rem; }
</style>

<script>
var selectedFile = null;

function handleVideo(input) {
    const file = input.files[0];
    if (!file) return;
    if (file.size > 20 * 1024 * 1024) {
        alert('File too large! Please upload under 20MB.');
        return;
    }
    selectedFile = file;
    document.getElementById('videoText').textContent = file.name;
    const url = URL.createObjectURL(file);
    document.getElementById('previewVideo').src = url;
    document.getElementById('videoPreview').style.display = 'block';
}

function analyzePosture() {
    if (!selectedFile) return;
    document.getElementById('loadingBox').style.display = 'flex';
    document.getElementById('feedbackCard').style.display = 'none';

    const formData = new FormData();
    formData.append('video', selectedFile);

    fetch('/AI/AnalyzePosture', { method: 'POST', body: formData })
        .then(r => r.json())
        .then(data => {
            document.getElementById('loadingBox').style.display = 'none';
            document.getElementById('feedbackText').textContent = data.feedback;
            document.getElementById('feedbackCard').style.display = 'block';
        });
}
</script>