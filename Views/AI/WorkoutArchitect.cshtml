@{
    ViewData["Title"] = "AI Workout Architect";
}

<div class="ai-container">
    <div class="ai-card">
        <h2 class="ai-title">💪 AI Workout Architect</h2>
        <p class="ai-subtitle">Tell us your goal — AI will build your 7-day plan!</p>

        <div class="form-group mb-3">
            <label class="form-label">Injury / Limitation</label>
            <input class="nexfit-input" id="injury" placeholder="e.g. Shoulder pain, or None" />
        </div>
        <div class="form-group mb-3">
            <label class="form-label">Your Goal</label>
            <input class="nexfit-input" id="goal" placeholder="e.g. Weight loss, Muscle gain" />
        </div>
        <div class="form-group mb-3">
            <label class="form-label">Fitness Level</label>
            <select class="nexfit-input" id="level">
                <option>Beginner</option>
                <option>Intermediate</option>
                <option>Advanced</option>
            </select>
        </div>

        <button class="ai-btn" onclick="generatePlan()">✨ Generate My Plan</button>

        <div id="loadingBox" style="display:none;" class="loading-box mt-3">
            <div class="spinner"></div>
            <span>AI is crafting your plan...</span>
        </div>

        <div id="planCard" style="display:none;" class="plan-card mt-3">
            <div class="plan-header">
                <span>Your 7-Day Plan</span>
                <button onclick="copyPlan()" class="copy-btn">📋 Copy</button>
            </div>
            <pre id="planText"></pre>
        </div>

        <div id="errorBox" style="display:none;" class="error-box mt-3">
            <span id="errorText"></span>
        </div>
    </div>
</div>

<style>
    .ai-container { max-width: 680px; margin: 2rem auto; padding: 0 1rem; }
    .ai-card { background: rgba(15,23,42,.95); border: 1px solid rgba(255,255,255,.08); border-radius: 16px; padding: 2rem; box-shadow: 0 2px 20px rgba(0,0,0,.3); }
    .ai-title { color: #38bdf8; font-size: 1.5rem; font-weight: 700; margin-bottom: 0.25rem; }
    .ai-subtitle { color: #94a3b8; margin-bottom: 1.5rem; }
    .form-label { font-weight: 600; font-size: 0.9rem; color: #cbd5e1; display: block; margin-bottom: 0.4rem; }
    .nexfit-input { width: 100%; padding: 0.65rem 0.9rem; border: 1px solid rgba(255,255,255,.1); border-radius: 10px; font-size: 0.95rem; color: #f1f5f9; background: rgba(255,255,255,.05); box-sizing: border-box; }
    .nexfit-input:focus { outline: none; border-color: #38bdf8; background: rgba(56,189,248,.05); }
    .nexfit-input option { background: #1e293b; color: #f1f5f9; }
    .mb-3 { margin-bottom: 1rem; }
    .mt-3 { margin-top: 1rem; }
    .ai-btn { background: linear-gradient(135deg,#2563eb,#38bdf8); color: white; border: none; border-radius: 10px; padding: 0.75rem 1.5rem; font-size: 0.95rem; cursor: pointer; font-weight: 700; width: 100%; margin-top: 0.5rem; }
    .ai-btn:hover { opacity: 0.9; }
    .loading-box { display: flex; align-items: center; gap: 0.75rem; background: rgba(56,189,248,.08); border-radius: 10px; padding: 1rem; color: #38bdf8; }
    .spinner { width: 20px; height: 20px; border: 2px solid rgba(56,189,248,.2); border-top-color: #38bdf8; border-radius: 50%; animation: spin 0.8s linear infinite; flex-shrink: 0; }
    @@keyframes spin { to { transform: rotate(360deg); } }
    .plan-card { border: 1px solid rgba(255,255,255,.08); border-radius: 12px; overflow: hidden; }
    .plan-header { background: linear-gradient(135deg,#2563eb,#38bdf8); color: white; padding: 0.85rem 1rem; display: flex; justify-content: space-between; align-items: center; font-weight: 700; }
    .copy-btn { background: rgba(255,255,255,.15); border: 1px solid rgba(255,255,255,.3); color: white; border-radius: 6px; padding: 0.3rem 0.75rem; cursor: pointer; font-size: 0.85rem; }
    .copy-btn:hover { background: rgba(255,255,255,.25); }
    #planText { white-space: pre-wrap; font-family: 'Plus Jakarta Sans', sans-serif; color: #e2e8f0; line-height: 1.8; font-size: 0.9rem; margin: 0; padding: 1.25rem; background: rgba(15,23,42,.8); }
    .error-box { background: rgba(127,29,29,.3); border: 1px solid rgba(252,165,165,.2); color: #fca5a5; border-radius: 10px; padding: 0.75rem 1rem; }
</style>

<script>
    function generatePlan() {
        const injury = document.getElementById('injury').value;
        const goal = document.getElementById('goal').value;
        const level = document.getElementById('level').value;

        if (!goal) {
            document.getElementById('errorText').textContent = 'Please enter your goal!';
            document.getElementById('errorBox').style.display = 'block';
            return;
        }

        document.getElementById('errorBox').style.display = 'none';
        document.getElementById('loadingBox').style.display = 'flex';
        document.getElementById('planCard').style.display = 'none';

        fetch('/AI/GenerateWorkout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ injury, goal, level })
        })
        .then(r => r.json())
        .then(data => {
            document.getElementById('loadingBox').style.display = 'none';
            document.getElementById('planText').textContent = data.plan;
            document.getElementById('planCard').style.display = 'block';
        })
        .catch(err => {
            document.getElementById('loadingBox').style.display = 'none';
            document.getElementById('errorText').textContent = 'Error generating plan. Please try again.';
            document.getElementById('errorBox').style.display = 'block';
        });
    }

    function copyPlan() {
        const text = document.getElementById('planText').textContent;
        navigator.clipboard.writeText(text);
        alert('Copied to clipboard!');
    }
</script>