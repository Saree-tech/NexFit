@{
    ViewData["Title"] = "AI Workout Architect";
}

<div class="ai-container">
    <div class="ai-card">
        <h2 class="ai-title">💪 AI Workout Architect</h2>
        <p class="ai-subtitle">Tell us your goal — AI will build your 7-day plan!</p>

        <div class="form-group mb-3">
            <label>Injury / Limitation</label>
            <input class="form-control" id="injury" placeholder="e.g. Shoulder pain, or None" />
        </div>
        <div class="form-group mb-3">
            <label>Your Goal</label>
            <input class="form-control" id="goal" placeholder="e.g. Weight loss, Muscle gain" />
        </div>
        <div class="form-group mb-3">
            <label>Fitness Level</label>
            <select class="form-select" id="level">
                <option>Beginner</option>
                <option>Intermediate</option>
                <option>Advanced</option>
            </select>
        </div>
        <button class="ai-btn" onclick="generatePlan()">✨ Generate My Plan</button>

        <div id="loadingBox" style="display:none;" class="loading-box mt-3">
            <div class="spinner"></div>
            <span>AI is crafting your plan...</span>
        </div>

        <div id="planCard" style="display:none;" class="plan-card mt-3">
            <div class="plan-header">
                <span>Your 7-Day Plan</span>
                <button onclick="copyPlan()" class="copy-btn">📋 Copy</button>
            </div>
            <pre id="planText" style="white-space:pre-wrap; font-family:inherit; padding:1rem; margin:0;"></pre>
        </div>
    </div>
</div>

<style>
.ai-container { max-width: 680px; margin: 2rem auto; padding: 0 1rem; }
.ai-card { background: white; border-radius: 16px; padding: 2rem; box-shadow: 0 2px 20px rgba(0,0,0,0.08); }
.ai-title { color: #6C47FF; font-size: 1.5rem; font-weight: 700; }
.ai-subtitle { color: #6B7280; margin-bottom: 1.5rem; }
.ai-btn { background: #6C47FF; color: white; border: none; border-radius: 10px; padding: 0.65rem 1.5rem; font-size: 0.95rem; cursor: pointer; width: 100%; }
.loading-box { display: flex; align-items: center; gap: 0.75rem; background: #F3F0FF; border-radius: 10px; padding: 1rem; color: #6C47FF; }
.spinner { width: 20px; height: 20px; border: 2px solid rgba(108,71,255,0.2); border-top-color: #6C47FF; border-radius: 50%; animation: spin 0.8s linear infinite; }
@@keyframes spin { to { transform: rotate(360deg); } }
.plan-card { border: 1px solid #E8E8F0; border-radius: 12px; overflow: hidden; }
.plan-header { background: #6C47FF; color: white; padding: 0.75rem 1rem; display: flex; justify-content: space-between; align-items: center; }
.copy-btn { background: transparent; border: 1px solid white; color: white; border-radius: 6px; padding: 0.2rem 0.6rem; cursor: pointer; }
.mt-3 { margin-top: 1rem; }
.mb-3 { margin-bottom: 1rem; }
</style>

<script>
function generatePlan() {
    const injury = document.getElementById('injury').value;
    const goal = document.getElementById('goal').value;
    const level = document.getElementById('level').value;
    if (!goal) { alert('Please enter your goal!'); return; }
    document.getElementById('loadingBox').style.display = 'flex';
    document.getElementById('planCard').style.display = 'none';
    fetch('/AI/GenerateWorkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ injury, goal, level })
    })
    .then(r => r.json())
    .then(data => {
        document.getElementById('loadingBox').style.display = 'none';
        document.getElementById('planText').textContent = data.plan;
        document.getElementById('planCard').style.display = 'block';
    });
}
function copyPlan() {
    navigator.clipboard.writeText(document.getElementById('planText').textContent);
    alert('Copied!');
}
</script>